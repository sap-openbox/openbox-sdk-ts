{
  "name": "@openbox-ai/openbox-sdk-ts",
  "version": "2.2.0",
  "description": "OpenBox TypeScript base SDK — shared governance, signing, and instrumentation behavior for Node/TS framework SDKs",
  "license": "MIT",
  "author": "OpenBox Team",
  "homepage": "https://github.com/OpenBox-AI/openbox-sdk-ts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenBox-AI/openbox-sdk-ts.git"
  },
  "bugs": {
    "url": "https://github.com/OpenBox-AI/openbox-sdk-ts/issues"
  },
  "keywords": [
    "openbox",
    "governance",
    "observability",
    "signing",
    "opentelemetry",
    "sdk"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24.10.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js",
      "default": "./dist/adapters/index.js"
    },
    "./approvals": {
      "types": "./dist/approvals/index.d.ts",
      "import": "./dist/approvals/index.js",
      "default": "./dist/approvals/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "default": "./dist/client/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js",
      "default": "./dist/config/index.js"
    },
    "./conformance": {
      "types": "./dist/conformance/index.d.ts",
      "import": "./dist/conformance/index.js",
      "default": "./dist/conformance/index.js"
    },
    "./context": {
      "types": "./dist/context/index.d.ts",
      "import": "./dist/context/index.js",
      "default": "./dist/context/index.js"
    },
    "./identity": {
      "types": "./dist/identity/index.d.ts",
      "import": "./dist/identity/index.js",
      "default": "./dist/identity/index.js"
    },
    "./instrumentation": {
      "types": "./dist/instrumentation/index.d.ts",
      "import": "./dist/instrumentation/index.js",
      "default": "./dist/instrumentation/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js",
      "default": "./dist/runtime/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "ci:check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run import:check",
    "clean": "rm -rf coverage dist",
    "format": "prettier --write .",
    "import:check": "node scripts/check-root-import-light.mjs",
    "interop:core": "node scripts/core-interop/run-core-workload-interop.mjs",
    "interop:core:packed": "node scripts/core-interop/run-core-workload-interop.mjs --packed",
    "lint": "eslint .",
    "pack:check": "npm pack --dry-run",
    "prepack": "npm run clean && npm run build",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "mongodb": "^6.21.0",
    "mysql2": "^3.22.6",
    "pg": "^8.22.0",
    "prettier": "^3.6.2",
    "redis": "^4.7.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  }
}
